# RegRipper Configuration Template
# Copy this file to .env and customize for your environment
# Note: RegRipper primarily uses command-line arguments, but this file
# documents common configuration options for reference

# =============================================================================
# General Settings
# =============================================================================

# Default plugin directory (relative to script location)
# PLUGIN_DIR=plugins

# Default output encoding
# OUTPUT_ENCODING=utf8

# Enable debug logging (0=off, 1=on)
# DEBUG=0

# =============================================================================
# CLI Defaults (rip.pl)
# =============================================================================

# Default hive file path (can be overridden with -r)
# DEFAULT_HIVE=

# Default plugin profile (can be overridden with -f)
# DEFAULT_PROFILE=ntuser

# Default system name for TLN output (can be overridden with -s)
# TLN_SYSTEM_NAME=

# Default username for TLN output (can be overridden with -u)
# TLN_USERNAME=

# Enable CSV output for plugin listing (0=off, 1=on)
# CSV_OUTPUT=0

# =============================================================================
# GUI Settings (rr.pl - Windows only)
# =============================================================================

# Default report file extension
# REPORT_EXT=txt

# Default log file extension
# LOG_EXT=log

# Window position (x,y)
# WINDOW_X=200
# WINDOW_Y=200

# Window size (width,height)
# WINDOW_WIDTH=500
# WINDOW_HEIGHT=420

# =============================================================================
# Plugin-Specific Settings
# =============================================================================

# Enable alert messages in plugins (0=off, 1=on)
# ENABLE_ALERTS=1

# Alert on suspicious paths (e.g., %AppData% in Run keys)
# ALERT_ON_SUSPICIOUS_PATHS=1

# Alert on Alternate Data Streams (ADS)
# ALERT_ON_ADS=1

# =============================================================================
# Output Settings
# =============================================================================

# Report output format (text, csv, json, tln)
# REPORT_FORMAT=text

# Include timestamps in report (0=off, 1=on)
# INCLUDE_TIMESTAMPS=1

# Timestamp format (iso8601, rfc2822, unix, custom)
# TIMESTAMP_FORMAT=iso8601

# Custom timestamp format (strftime format)
# CUSTOM_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S %Z

# =============================================================================
# Performance Settings
# =============================================================================

# Maximum recursion depth for registry traversal
# MAX_RECURSION_DEPTH=100

# Buffer size for file I/O (bytes)
# IO_BUFFER_SIZE=8192

# =============================================================================
# Security Settings
# =============================================================================

# Validate hive file signatures before parsing (0=off, 1=on)
# VALIDATE_HIVE_SIGNATURE=1

# Restrict plugin loading to plugins/ directory only (0=off, 1=on)
# RESTRICT_PLUGIN_DIR=1

# Maximum hive file size to process (bytes, 0=unlimited)
# MAX_HIVE_SIZE=0

# =============================================================================
# Development/Debug Settings
# =============================================================================

# Perl::Critic severity level (1-5, 5=most strict)
# PERLCRITIC_SEVERITY=3

# Enable test mode (uses test fixtures)
# TEST_MODE=0

# Test fixture directory
# TEST_FIXTURE_DIR=t/fixtures

# =============================================================================
# Docker/Container Settings
# =============================================================================

# Container user ID (for file permissions)
# CONTAINER_UID=1000

# Container group ID
# CONTAINER_GID=1000

# Working directory in container
# CONTAINER_WORKDIR=/workspace